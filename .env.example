# --- アプリ ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
# Supabase ダッシュボード > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role キー。RLS を迂回するのでサーバー側のみで使用し、絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps / Places ---
# Places API (New) を有効化したプロジェクトのキー
GOOGLE_MAPS_API_KEY=

# --- AI（どちらか一方でも動作する） ---
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# --- Stripe ---
# 未設定でもアプリは動く。その場合、課金画面はプランの一覧表示だけになる
STRIPE_SECRET_KEY=
# stripe listen / ダッシュボードの Webhook エンドポイントで発行される署名シークレット
STRIPE_WEBHOOK_SECRET=
# 各プランの Price ID（サブスクリプション・月次）
STRIPE_PRICE_ID_LIGHT=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_PRO=
